{
    "version": 2,
    "cleanUrls": true,
    "outputDirectory": "build/web",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/__/auth/(.*)",
            "destination": "https://whereabouts-510db.firebaseapp.com/__/auth/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}